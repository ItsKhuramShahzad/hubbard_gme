# --- outputs/ and results/: exclude everything EXCEPT PDF files ---
# Ignore all contents at any depth ...
outputs/**
results/**
# ... but keep the directory structure so git can descend ...
!outputs/**/
!results/**/
# ... and keep every .pdf at any depth.
!outputs/**/*.pdf
!results/**/*.pdf

# --- Large data files: never push ---
*.hdf5

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# --- WSL/Windows download markers ---
*Zone.Identifier

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- Machine-learning GME estimation: separate repository (gme_qml), not part of this package ---
gme_qml/
src/hubbard_gme/data_for_ML/

# --- Run logs, sync logs, editor backups, Dropbox metadata ---
/*.log
/rsync_*.txt
*~
*.bak
*com.dropbox.attrs
